// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Global user registry
model User {
  id             String        @id @default(uuid())
  clerkId        String?       @unique  // Clerk user id; null for legacy name-only users
  name           String        // Display name; not unique (two accounts can share a name)
  email          String?       // Verified primary email from Clerk
  imageUrl       String?
  isLeader       Boolean       @default(false)
  isAdmin        Boolean       @default(false)
  createdAt      DateTime      @default(now())

  participations Participant[]

  @@index([name])
}

// Per-tasting participation
model Participant {
  id            String   @id @default(uuid())
  tastingId     String
  tasting       Tasting  @relation(fields: [tastingId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  code          String   // 4-char alphanumeric, unique per tasting
  rejoinToken   String   @unique
  active        Boolean  @default(true)  // false = soft-deleted, ratings preserved
  pausedAt      DateTime?                // Stepped away: not waited on until they rate or rejoin
  avatar        String?                  // Christmas avatar key, unique within the tasting while pictures last
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  ratings       Rating[]
  flavorTags    FlavorTags[]

  @@unique([tastingId, userId])  // One participation per user per tasting
  @@unique([tastingId, code])
  @@index([rejoinToken])
  @@index([tastingId, active])
}

// Global beer catalog
model Beer {
  id            String   @id @default(uuid())
  name          String
  brewery       String
  styles        String[] // Array of beer styles for statistics (e.g., ["Ljós lager", "Amber", "Vínar", "Classic"])
  abv           Float?
  country       String?
  imageUrl      String?
  description   String?

  // Product details (Quick Wins)
  containerSize Int?     // Volume in ml (330, 500, 750, etc.)
  containerType String?  // "Can", "Bottle", "Keg"
  productNumber String?  // Vínbúðin product/SKU number
  vinbudinUrl   String?  // Direct link to product page
  priceISK      Float?   // Price in Icelandic Króna
  pricePerLiter Float?   // Price per liter in ISK

  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tastingBeers  TastingBeer[]

  @@unique([name, brewery, containerSize, containerType])  // Prevent duplicate packaging variants
  @@index([name])
  @@index([brewery])
  @@index([productNumber])
}

// Tasting event
model Tasting {
  id                 String   @id @default(uuid())
  title              String
  status             String   @default("draft")  // "draft" | "active" | "closed"
  currentTastingBeerId String?  // References TastingBeer.id
  createdBy          String?  // User.id who created it

  version            Int      @default(1)  // Increments on state changes
  nudgedAt           DateTime?  // Last nudge; clients poll and fire when it changes
  nudgedParticipantIds String[] @default([])  // Pending participants at time of last nudge
  hideScoresUntilAllRated Boolean @default(false)  // Current beer's scores stay hidden until every active participant has rated
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tastingBeers       TastingBeer[]
  participants       Participant[]
  ratings            Rating[]

  @@index([status])
  @@index([createdAt])
}

// Instance of a beer in a specific tasting
model TastingBeer {
  id            String   @id @default(uuid())
  tastingId     String
  tasting       Tasting  @relation(fields: [tastingId], references: [id], onDelete: Cascade)

  beerId        String?  // Optional - references global Beer catalog
  beer          Beer?    @relation(fields: [beerId], references: [id], onDelete: SetNull)

  // Allow custom beers not in catalog
  customName    String?
  customBrewery String?
  customStyle   String?
  customAbv     Float?

  // Price at the time of the tasting - catalog prices change every year
  priceISK      Float?
  pricePerLiter Float?

  orderIndex    Int      @default(0)
  status        String   @default("untasted")  // "untasted" | "current" | "finished"

  // Timer tracking
  currentSince  DateTime? // When beer became "current"
  finishedAt    DateTime? // When beer was finished

  createdAt     DateTime @default(now())

  ratings       Rating[]
  flavorTags    FlavorTags[]

  @@index([tastingId, status])
  @@index([tastingId, orderIndex])
  @@index([beerId])
}

// Rating submission
model Rating {
  id              String      @id @default(uuid())
  tastingId       String
  tasting         Tasting     @relation(fields: [tastingId], references: [id], onDelete: Cascade)

  tastingBeerId   String
  tastingBeer     TastingBeer @relation(fields: [tastingBeerId], references: [id], onDelete: Cascade)

  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  score           Float       // 1.0 to 10.0, step 0.5
  tags            String[]    @default([])  // Unused: tags moved to FlavorTags, kept until the old deploy is gone
  note            String?     // Optional free-text tasting note
  groupGuess      Float?      // Guess at the group average, only taken while scores are hidden
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([tastingBeerId, participantId])  // One rating per tasting beer per participant
  @@index([tastingBeerId])
  @@index([participantId])
  @@index([tastingId])  // For fetching all ratings in a tasting (analytics/export)
}

// A participant's flavor tags for a beer, saved on every tap and apart from the rating,
// so picking tags never submits a score
model FlavorTags {
  tastingBeerId   String
  tastingBeer     TastingBeer @relation(fields: [tastingBeerId], references: [id], onDelete: Cascade)

  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  tags            String[]    @default([])  // Flavor tag keys from src/lib/flavorTags.ts
  updatedAt       DateTime    @updatedAt

  @@id([tastingBeerId, participantId])
}

// Admin authentication
model AdminAuth {
  id            String    @id @default(uuid())
  passwordHash  String    // Hash of "admin" or custom secret
  lastLoginAt   DateTime?

  @@map("admin_auth")
}
