# App Configuration
NEXT_PUBLIC_APP_NAME=BeerTasting
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/beertasting

# Authentication (Clerk; provisioned by the Vercel Marketplace integration, `vercel env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Comma-separated verified emails that are always admin
ADMIN_EMAILS=you@example.com

# Push nudges (optional; without these, nudges only reach open screens)
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Export Configuration
EXPORT_MAX_ROWS=100000

# Real-time Configuration
SSE_RECONNECT_MAX_ATTEMPTS=3
POLLING_INTERVAL_MS=1000

# Wrap-up Configuration
WRAP_UP_DURATION_MS=5000  # 5 seconds minimum

# Monitoring (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
